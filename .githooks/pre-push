#!/usr/bin/env bash
# Defensive local hook only. Git hooks are bypassable; use GitHub server permissions too.
set -euo pipefail
fail() { printf 'OmniMemo push guard: %s\n' "$*" >&2; exit 1; }
remote_name="${1:-}"
actual_url="${2:-}"
[[ "$remote_name" == 'origin' ]] || fail 'Only origin is allowed.'
# Strict SSH-only policy in this reference hook. HTTPS requires a separately verified adapter.
if [[ "$actual_url" =~ ^git@github[.]com:YanIanZ/[A-Za-z0-9_.-]+([.]git)?$ ]]; then :
elif [[ "$actual_url" =~ ^ssh://git@github[.]com/YanIanZ/[A-Za-z0-9_.-]+([.]git)?$ ]]; then :
else fail 'Destination must be an SSH URL under github.com/YanIanZ/.'; fi
push_url="$(git remote get-url --push origin)" || fail 'Cannot resolve effective push URL.'
[[ "$push_url" == "$actual_url" ]] || fail 'Effective push URL differs from invoked destination.'
[[ -z "${GIT_SSH_COMMAND:-}" && -z "${GIT_SSH:-}" ]] || fail 'Custom SSH environment detected; manual identity verification required.'
[[ -z "$(git config --get core.sshCommand || true)" ]] || fail 'core.sshCommand override detected; manual verification required.'
expected_email="$(git config --local --get omnimem.guard.email || true)"
[[ -n "$expected_email" ]] || fail 'Set omnimem.guard.email to the owner-verified address.'
[[ "$(git config --local --get user.name || true)" == 'YanIanZ' ]] || fail 'user.name != YanIanZ.'
[[ "$(git config --local --get user.email || true)" == "$expected_email" ]] || fail 'user.email != approved email.'
# SSH -T GitHub commonly returns status 1 on successful authentication (no shell).
ssh_output="$(ssh -T -o BatchMode=yes -o StrictHostKeyChecking=yes git@github.com 2>&1 || true)"
[[ "$ssh_output" == *'Hi YanIanZ!'* ]] || fail 'SSH authenticated GitHub account is not verified as YanIanZ.'
# SSH identity is decisive for this SSH-only hook. GH CLI account is advisory but must not contradict it.
if command -v gh >/dev/null 2>&1; then
  cli_user="$(gh api user --jq .login 2>/dev/null || true)"
  [[ -z "$cli_user" || "$cli_user" == 'YanIanZ' ]] || fail "gh CLI active account differs: $cli_user"
fi
# SHA-1 and SHA-256 repositories can use different all-zero object IDs.
zero_pattern='^0+$'
while read -r local_ref local_oid remote_ref remote_oid; do
  [[ -n "${local_ref:-}" ]] || continue
  [[ "$local_ref" == refs/heads/* ]] || fail 'Tag/non-branch push is blocked by default.'
  [[ ! "$local_oid" =~ $zero_pattern ]] || fail 'Ref deletion not permitted.'
  # Requires an up-to-date view of the remote; fail-closed when unavailable.
  if [[ ! "$remote_oid" =~ $zero_pattern ]]; then
    git cat-file -e "$remote_oid^{commit}" 2>/dev/null || fail 'Fetch origin before pushing (missing remote commit).'
    git merge-base --is-ancestor "$remote_oid" "$local_oid" || fail 'Non-fast-forward push is blocked.'
    rev_range="$remote_oid..$local_oid"
    commits="$(git rev-list "$rev_range")" || fail 'Cannot list commits.'
  else
    commits="$(git rev-list "$local_oid" --not --remotes=origin)" || fail 'Cannot list new commits.'
  fi
  while IFS= read -r sha; do
    [[ -n "$sha" ]] || continue
    [[ "$(git show -s --format='%an' "$sha")" == 'YanIanZ' ]] || fail "Commit $sha has unexpected author."
    [[ "$(git show -s --format='%cn' "$sha")" == 'YanIanZ' ]] || fail "Commit $sha has unexpected committer."
    [[ "$(git show -s --format='%ae' "$sha")" == "$expected_email" ]] || fail "Commit $sha has unexpected author email."
    [[ "$(git show -s --format='%ce' "$sha")" == "$expected_email" ]] || fail "Commit $sha has unexpected committer email."
    if git show -s --format=%B "$sha" | grep -Ei '^(Co-authored-by|Signed-off-by|Generated-by):' >/dev/null; then
      fail "Commit $sha has an attribution trailer requiring review."
    fi
  done <<< "$commits"
done
